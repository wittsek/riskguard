# All keys are optional. Guest leak calculator + full linter work with this file empty.
# Copy to .env.local only if you want login, GPT, or Telegram.
# Never commit real keys. Restart the single `next dev` process after changing these.
# Docker: `docker compose up --build` also works with no keys. NEXT_PUBLIC_* is baked at build time.

# Optional login + cloud save. Format: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Coaching always works without this (rule-based fallback).
# When set, /api/coach and /api/run-audit use GPT-4o-mini for the summary.
OPENAI_API_KEY=

# Optional, server-only. Leave empty to keep Telegram alerts off (no send, no crash).
# Never prefix with NEXT_PUBLIC_. After a saved audit, one message is sent if the
# signed-in profile has telegram_chat_id.
#
# Set the inbound webhook (public HTTPS host):
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://YOUR_DOMAIN/api/webhook/telegram"}'
# Local v1: message the bot or @userinfobot, paste the chat ID in Settings.
TELEGRAM_BOT_TOKEN=
