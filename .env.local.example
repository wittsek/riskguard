# All keys are optional. Guest leak calculator + full linter work with this file empty.
# Copy to .env.local only if you want login, an LLM coach, or Telegram.
# Never commit real keys. Restart the single `next dev` process after changing these.
# Docker: `docker compose up --build` also works with no keys. NEXT_PUBLIC_* is baked at build time.

# Optional login + cloud save. Format: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site for auth emails. Set this on Vercel to https://getriskguard.com
# so confirmation links never fall back to localhost. Leave empty on your laptop
# if you want magic links to stay on http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional LLM coach. Any OpenAI-compatible Chat Completions host works.
# No key → rule-based notes. LLM_* wins over OPENAI_* if both are set.
#
# OpenAI (default model gpt-4o-mini when LLM_BASE_URL is empty):
#   LLM_API_KEY=sk-...
#   # or OPENAI_API_KEY=sk-...
#
# OpenRouter + Ox Alpha:
#   LLM_API_KEY=sk-or-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=stealth/ox-alpha
#
# Ollama (local):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=llama3.1
#
# Custom base URL requires LLM_MODEL. Optional: LLM_TIMEOUT_MS=20000
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=

# Optional, server-only. Leave empty to keep Telegram alerts off (no send, no crash).
# Never prefix with NEXT_PUBLIC_. After a saved audit, one message is sent if the
# signed-in profile has telegram_chat_id.
#
# Set the inbound webhook (public HTTPS host):
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://YOUR_DOMAIN/api/webhook/telegram"}'
# Local v1: message the bot or @userinfobot, paste the chat ID in Settings.
TELEGRAM_BOT_TOKEN=
